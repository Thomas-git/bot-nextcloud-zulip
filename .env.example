# Zulip bot credentials (downloadid from parameters > Bots in Zulip)
ZULIP_EMAIL=nextcloud-bot@you-domain.zulipchat.com
ZULIP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZULIP_SITE=https://your-domain.zulipchat.com

# Nextcloud
NEXTCLOUD_URL=https://nextcloud.example.com
NEXTCLOUD_USER=admin
NEXTCLOUD_PASSWORD=password

# Optionnal : how many days for "recent"
RECENT_DAYS=7

# Log level : WARNING (default), INFO, DEBUG
# LOG_LEVEL=DEBUG
