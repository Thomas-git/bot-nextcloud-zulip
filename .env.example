# Zulip bot credentials (téléchargés depuis Paramètres > Bots dans Zulip)
ZULIP_EMAIL=nextcloud-bot@votre-domaine.zulipchat.com
ZULIP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZULIP_SITE=https://votre-domaine.zulipchat.com

# Nextcloud
NEXTCLOUD_URL=https://nextcloud.example.com
NEXTCLOUD_USER=admin
NEXTCLOUD_PASSWORD=mot-de-passe

# Webhook pour les callbacks de clics (zforms interactifs)
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=5000
WEBHOOK_SECRET=une-clé-secrète-aléatoire

# Optionnel : nombre de jours pour "recent"
RECENT_DAYS=7
